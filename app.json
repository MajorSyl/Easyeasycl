{
  "expo": {
    "name": "Easyfen",
    "slug": "easyfen",
    "scheme": "easyfen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f47d3108-b9d4-4959-9c1e-0688c4009cd0"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.easyfen.app",
      "adaptiveIcon": {
        "backgroundColor": "#3E6FBF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Easyfen uses your photos to add pictures to your listings.",
          "cameraPermission": "Easyfen uses your camera to take pictures for your listings."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f47d3108-b9d4-4959-9c1e-0688c4009cd0"
      }
    },
    "owner": "syl-express"
  }
}
